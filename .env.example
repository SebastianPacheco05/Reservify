# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/reservify

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Wompi - Configuración de pagos
# Obtén estas claves desde el dashboard de Wompi: https://dashboard.wompi.co
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxx
WOMPI_API_URL=https://sandbox.wompi.co/v1
# Para producción usar: https://production.wompi.co/v1

# WOMPI_INTEGRITY_SECRET - Secreto de integridad para validar transacciones y webhooks
# Obtén este secreto desde: Dashboard de Wompi > Developers > Secrets for technical integration
WOMPI_INTEGRITY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (si aplica)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=tu_password

# JWT Secret (si aplica)
# JWT_SECRET=tu_secret_jwt_muy_seguro
